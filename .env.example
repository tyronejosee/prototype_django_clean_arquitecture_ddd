# Project
PROJECT_NAME="Project Marketly"
PROJECT_DESCRIPTION="This repository implements a Django application following the principles of Clean Architecture and Domain-Driven Design (DDD). It serves as a practical example of how to structure a robust and maintainable application."
PROJECT_VERSION=0.1.0

# Enviroment
DJANGO_PORT=8000
DJANGO_SECRET_KEY=<secret-key>
IS_RUNNING_PIPELINE=False
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database & Cache
POSTGRES_DB=<db-name>
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>
POSTGRES_HOST=<db-host>
POSTGRES_PORT=<db-port>
REDIS_PORT=6379
CACHE_LOCATION=<elasticache-endpoint>

# AWS
AWS_ACCESS_KEY_ID=<aws-access-key>
AWS_SECRET_ACCESS_KEY=<aws-secret-key>

# Storage & CDN
AWS_STORAGE_BUCKET_NAME=<aws-bucket-name>
AWS_S3_REGION_NAME=<aws-region-name>
AWS_S3_CUSTOM_DOMAIN=<aws-cloudfront-domain>

# Pipeline
AWS_CLOUDFRONT_DIST_ID=<aws-cloudfront-dist-id>
AWS_ECS_CLUSTER_PROD=<aws-ecs-cluster-prod>
AWS_ECS_SERVICE_PROD=<aws-ecs-service-prod>
AWS_ECS_CLUSTER_STAGING=<aws-ecs-cluster-staging>
AWS_ECS_SERVICE_STAGING=<aws-ecs-service-staging>

# Payment
PAYPAL_CLIENT_ID=<paypal-client-id>
PAYPAL_CLIENT_SECRET=<paypal-client-secret>

# Documentation
LICENCE_NAME="MIT License"
LICENCE_URL=https://github.com/tyronejose/project_marketly/blob/main/LICENSE
CONTACT_NAME="Tyrone Jose"
CONTACT_URL=https://github.com/tyronejose
